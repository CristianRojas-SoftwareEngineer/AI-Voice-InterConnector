node_modules/
build/
dist/
dist_test/
# Artefactos de build de Cargo/Rust
target/
# Voces de usuario ignoradas, pero la voz de fábrica 'default' se versiona
# (se empaqueta vía --add-data y sirve de voz por defecto).
voices/*
!voices/default/
ai-voice-interconnector.png
*.spec
# Config de Claude Code: ignorar todo el contenido de .claude/ (incluido el prompt
# de continuidad — se genera localmente y no se versiona).
.claude/*
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
# Artefactos de coverage: generados por `pytest --cov`, no se versionan.
.coverage
coverage.json
coverage.xml

# Lockfile de uv (proyecto usa requirements-lock.txt)
uv.lock

# Bus de orquestación (artefactos de proceso, nunca se commitean)
.claude/orchestration/

# --- Runtime nativo Rust/CT2 y motor Qwen (desbloqueo de Fase 0) ---
# Pesos de modelos (CT2 + HF), multi-GB, nunca se versionan.
models/
# Muestras/artefactos de audio de pruebas locales (no son fuente).
samples/
# Motor Qwen3-TTS vendorizado: se versionan SOLO fuentes C/H/CU, shims,
# Makefile, scripts y docs; se excluyen pesos, presets y media binaria.
vendor/qwen3-tts/qwen3-tts-0.6b/
vendor/qwen3-tts/presets/
vendor/**/*.safetensors
vendor/**/*.gguf
vendor/**/*.qvoice
vendor/**/*.bin
vendor/**/*.wav
vendor/**/*.mp3
# El .gitignore vendorizado de qwen3-tts re-incluye `!tests/golden/*.wav`; excluir
# el directorio padre invalida esa negación (git no re-incluye bajo un dir excluido).
vendor/qwen3-tts/tests/golden/
# Artefactos de compilación C (objetos, libs estáticas, deps, ejecutables).
*.o
*.a
*.d
*.exe
# Binarios del motor TTS: ahora se compilan desde fuente en CI/dev vía
# `cargo run -p xtask -- build-engine` (no se versionan). `qwen_tts.exe` ya lo
# cubre `*.exe`; `qwen_tts` (Unix) necesita regla propia (sin extensión).
vendor/qwen3-tts/qwen_tts
