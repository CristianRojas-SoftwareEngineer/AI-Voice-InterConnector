# Artefactos de build de Cargo/Rust
target/
# Archivos de distribución que escribe `cargo xtask package`.
/artifacts/
# Registro que deja el borrado diferido de `target/` cuando no logra retirarlo
# (`cargo xtask clean` lo retira cuando `target/` ya no existe).
/*.removal-failed.log
# Config local de Claude Code no versionada; solo se comparte la skill E2E de Windows.
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/test-windows-e2e-as-final-user/
!.claude/skills/test-windows-e2e-as-final-user/SKILL.md
# Artefactos de coverage (lcov/cargo-llvm-cov), no se versionan.
.coverage
coverage.json
coverage.xml

# Cachés efímeras de CI (no versionar)
Cargo.lock.cachekey
.cache-root
.sccache-week
.vendor-patches.list
.vendor-patches.tree
cargo-timings/
ort-bundle/
ffmpeg-bundle/
engine-bundle/
# Informe NUnit que Pester escribe en el directorio actual con `-CI`
testResults.xml
# Planes, bitácoras y artefactos locales de trabajo; no se versionan.
.work/
