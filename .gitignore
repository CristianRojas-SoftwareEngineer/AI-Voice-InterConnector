# Artefactos de build de Cargo/Rust
target/
# Archivos de distribución que escribe `cargo xtask package`.
/artifacts/
# Registro que deja el borrado diferido de `target/` cuando no logra retirarlo
# (`cargo xtask clean` lo retira cuando `target/` ya no existe).
/*.removal-failed.log
# Config de Claude Code: ignorar todo el contenido de .claude/ (incluido el prompt
# de continuidad — se genera localmente y no se versiona).
.claude/*
# Artefactos de coverage (lcov/cargo-llvm-cov), no se versionan.
.coverage
coverage.json
coverage.xml

# --- Runtime nativo Rust/CT2 y motor Qwen (desbloqueo de Fase 0) ---
# Motor Qwen3-TTS vendorizado: se versionan SOLO fuentes C/H/CU, shims,
# Makefile, scripts y docs; se excluyen pesos, presets y media binaria.
vendor/qwen3-tts/qwen3-tts-0.6b/
vendor/qwen3-tts/presets/
vendor/**/*.safetensors
vendor/**/*.gguf
vendor/**/*.qvoice
vendor/**/*.bin
vendor/**/*.wav
vendor/**/*.mp3
# El .gitignore vendorizado de qwen3-tts re-incluye `!tests/golden/*.wav`; excluir
# el directorio padre invalida esa negación (git no re-incluye bajo un dir excluido).
vendor/qwen3-tts/tests/golden/
# Artefactos de compilación C del motor (objetos, libs estáticas, deps,
# ejecutables). Se acotan a su directorio: en el resto de `vendor/` hay copias
# de crates que se compilan enteras desde sus fuentes y no deben perder ficheros.
vendor/qwen3-tts/**/*.o
vendor/qwen3-tts/**/*.a
vendor/qwen3-tts/**/*.d
vendor/qwen3-tts/**/*.exe
# Binarios del motor TTS: se compilan desde fuente en CI/dev vía
# `cargo xtask build-engine` (no se versionan). `qwen_tts.exe` ya lo cubre la
# regla de `*.exe`; `qwen_tts` (Unix) necesita regla propia (sin extensión).
vendor/qwen3-tts/qwen_tts
# compile_commands.json (soporte editor/clangd): generado localmente con
# `compiledb` a partir del Makefile real; contiene rutas absolutas del
# entorno MSYS2/UCRT64 de cada máquina, no se versiona ni se usa en CI.
vendor/qwen3-tts/compile_commands.json
# Cachés efímeras de CI (no versionar)
Cargo.lock.cachekey
vendor/qwen3-tts/.engine-cachekey
ort-bundle/
ffmpeg-bundle/
# Informe NUnit que Pester escribe en el directorio actual con `-CI`
testResults.xml
.work/release-and-E2E.md
